# Local development only. Replace YOUR_LOCAL_PASSWORD with your local DB password.
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/anonna_mart_dev
FRONTEND_URL=http://localhost:3000
# bKash tokenized checkout. Use sandbox credentials for testing; keep secrets
# in the deployment secret manager, never in source control.
BKASH_API_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# Generate a unique 32-byte key as 64 hexadecimal characters; store in a secret manager.
BKASH_TOKEN_ENCRYPTION_KEY=
BKASH_CALLBACK_URL=https://api.example.com/api/payments/bkash/callback
PAYMENT_WORKER_INTERVAL_MS=5000
# Checkout tax is tax-exclusive and applied to all products; configure per tax counsel.
CHECKOUT_TAX_RATE_PERCENT=0
# Transactional email delivery service. Options: resend, console
EMAIL_PROVIDER=console
EMAIL_FROM=Anonna Mart <no-reply@anonnamart.com>
RESEND_API_KEY=
# Set API_IMAGE to the immutable registry image digest before Docker Compose deployment.
API_IMAGE=
# Shared auth limiter. If unset/unavailable, the API uses bounded per-process
# throttling; provision a shared atomic service for multi-replica production.
# Optional Redis URL for distributed rate limiting and caching:
REDIS_URL=
AUTH_RATE_LIMIT_URL=
AUTH_RATE_LIMIT_TOKEN=
# The local provisioning command requires these in the invoking shell; it does
# not load this file and never falls back to DATABASE_URL. The URL must use a
# loopback host and match all independently supplied target identifiers.
ADMIN_PROVISION_DATABASE_URL=
ADMIN_PROVISION_EXPECTED_HOST=localhost
ADMIN_PROVISION_EXPECTED_NAME=anonna_mart_dev
ADMIN_PROVISION_EXPECTED_USER=postgres
ADMIN_PROVISION_EXPECTED_PG_MAJOR=18
# Comma-separated exact socket peer IPs for trusted ingress proxies. The proxy
# must overwrite X-Forwarded-For and X-Real-IP; empty means neither is trusted.
TRUSTED_PROXY_IPS=
NODE_ENV=development

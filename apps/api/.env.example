# Local development only. Replace YOUR_LOCAL_PASSWORD with your local DB password.
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/anonna_mart_dev
FRONTEND_URL=http://localhost:3000
PAYMENT_WEBHOOK_SECRET=
# Required for auth rate limiting before serving production traffic. The service must
# implement POST /v1/consume atomically; see apps/api/README.md.
AUTH_RATE_LIMIT_URL=
AUTH_RATE_LIMIT_TOKEN=
# The local provisioning command requires these in the invoking shell; it does
# not load this file and never falls back to DATABASE_URL. The URL must use a
# loopback host and match all independently supplied target identifiers.
ADMIN_PROVISION_DATABASE_URL=
ADMIN_PROVISION_EXPECTED_HOST=localhost
ADMIN_PROVISION_EXPECTED_NAME=anonna_mart_dev
ADMIN_PROVISION_EXPECTED_USER=postgres
ADMIN_PROVISION_EXPECTED_PG_MAJOR=18
# Comma-separated exact socket peer IPs for trusted ingress proxies; empty means no proxy is trusted.
TRUSTED_PROXY_IPS=
NODE_ENV=development
